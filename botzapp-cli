#!/usr/bin/env bash
cd "$(dirname "$0")"

if [ -f .venv/bin/activate ]; then
  source .venv/bin/activate
elif [ -f venv/bin/activate ]; then
  source venv/bin/activate
fi

if [ $# -eq 0 ]; then
  set -- chat
fi

if [ -x .venv/bin/python ]; then
  exec .venv/bin/python app/interfaces/cli/main.py "$@"
elif [ -x venv/bin/python ]; then
  exec venv/bin/python app/interfaces/cli/main.py "$@"
else
  exec python3 app/interfaces/cli/main.py "$@"
fi
