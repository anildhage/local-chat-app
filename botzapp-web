#!/usr/bin/env bash
cd "$(dirname "$0")"

if [ -f .venv/bin/activate ]; then
  source .venv/bin/activate
elif [ -f venv/bin/activate ]; then
  source venv/bin/activate
fi

echo "Starting BotZapp web UI at http://127.0.0.1:8000"
exec uvicorn app.interfaces.api.main:app --reload --host 0.0.0.0 --port 8000
